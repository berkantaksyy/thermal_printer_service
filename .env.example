# ── Application ─────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

# ── Security ─────────────────────────────────────────────────────────────────
# Bearer token for API authentication (change before production use)
API_BEARER_TOKEN=change-me-secret-token

# ── Printer defaults ──────────────────────────────────────────────────────────
# "usb" or "lan"
DEFAULT_CONNECTION_TYPE=usb

# USB device (Cashino KP-300/KP-301H vendor:product IDs)
USB_VENDOR_ID=0x0456
USB_PRODUCT_ID=0x0808

# LAN printer
LAN_HOST=192.168.1.100
LAN_PORT=9100

# Connection retry / backoff
RECONNECT_MAX_RETRIES=5
RECONNECT_BACKOFF_BASE=2
RECONNECT_BACKOFF_MAX=60

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_DIR=./logs
LOG_MAX_SIZE_MB=10
LOG_KEEP_DAYS=30

# ── i18n ─────────────────────────────────────────────────────────────────────
# Supported: tr, en, de, fr
DEFAULT_LANGUAGE=en

# ── LLM (Optional bonus feature) ─────────────────────────────────────────────
# NOTE: This is an OPTIONAL bonus feature. It requires an external API key
# from OpenRouter (https://openrouter.ai). If LLM_ENABLED=false (default),
# the service works fully without any external dependency or API key.
# As required by the task rules: "Dış servis/anahtar gerektiren ücretli SDK
# kullanmayınız (gerekirse açıkça not ediniz)" — LLM is explicitly optional,
# disabled by default, and documented here.
LLM_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
