# ── Application ─────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

# ── Security ─────────────────────────────────────────────────────────────────
# Bearer token for API authentication (change before production use)
API_BEARER_TOKEN=change-me-secret-token

# ── Printer defaults ──────────────────────────────────────────────────────────
# "usb" or "lan"
DEFAULT_CONNECTION_TYPE=usb

# USB device (Cashino KP-300/KP-301H vendor:product IDs)
# Decimal values: 0x0456 = 1110, 0x0808 = 2056
# Both hex ("0x0456") and decimal ("1110") formats are accepted.
USB_VENDOR_ID=1110
USB_PRODUCT_ID=2056

# LAN printer
LAN_HOST=192.168.1.100
LAN_PORT=9100

# Connection retry / backoff
RECONNECT_MAX_RETRIES=5
RECONNECT_BACKOFF_BASE=2
RECONNECT_BACKOFF_MAX=60

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_DIR=./logs
LOG_MAX_SIZE_MB=10
LOG_KEEP_DAYS=30

# ── i18n ─────────────────────────────────────────────────────────────────────
# Supported: tr, en, de, fr
DEFAULT_LANGUAGE=en

# ── LLM — Groq (Optional bonus feature) ──────────────────────────────────────
# NOTE: This is an OPTIONAL bonus feature. It requires a free Groq API key.
# Get your key at: https://console.groq.com (free tier available)
# If LLM_ENABLED=false (default), the service works 100% without any LLM.
# As required by the task rules: "Dış servis/anahtar gerektiren ücretli SDK
# kullanmayınız (gerekirse açıkça not ediniz)" — LLM is explicitly optional,
# disabled by default, and documented here.
LLM_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=llama3-8b-8192
GROQ_BASE_URL=https://api.groq.com/openai/v1
